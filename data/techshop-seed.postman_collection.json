{
  "info": {
    "name": "TechShop - Demo data import",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demo data only. Set adminToken and demoPassword (8-128 characters) in collection variables. Run folders in order once. For repeatable imports use scripts/seed-api.mjs. This collection creates COD orders but never marks payments or deliveries. Product prices/specifications are fictional; images are illustrative."
